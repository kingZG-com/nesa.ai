# ─── Version Control ──────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── PHP / Composer ───────────────────────────────────────────
vendor/
*.log

# ─── Laravel Environment (NEVER bake secrets into image) ──────

.env.local
.env.development
.env.staging
.env.test
# Keep .env.example so devs know required vars
!.env.example

# ─── Laravel generated caches (rebuilt in container) ──────────
bootstrap/cache/*.php
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/

# ─── Docker files (not needed inside image) ───────────────────
docker-compose.yaml
docker-compose.yml
docker-compose.override.yml
Dockerfile*
.dockerignore

# ─── IDE / Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Tests ────────────────────────────────────────────────────
tests/
phpunit.xml
phpunit.xml.dist

# ─── Documentation ────────────────────────────────────────────
README.md
CHANGELOG.md
LICENSE
docs/
